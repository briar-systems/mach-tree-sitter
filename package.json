{
  "name": "tree-sitter-mach",
  "version": "0.6.0",
  "description": "Tree-sitter grammar for the Mach programming language",
  "type": "module",
  "license": "MIT",
  "author": "Briar Systems LLC",
  "repository": {
    "type": "git",
    "url": "https://github.com/briar-systems/mach-tree-sitter.git"
  },
  "keywords": [
    "tree-sitter",
    "parser",
    "mach",
    "language"
  ],
  "main": "bindings/node/index.js",
  "types": "bindings/node/index.d.ts",
  "exports": {
    ".": {
      "types": "./bindings/node/index.d.ts",
      "import": "./bindings/node/index.js"
    }
  },
  "scripts": {
    "build": "tree-sitter generate && node-gyp rebuild",
    "generate": "tree-sitter generate",
    "install": "node-gyp-build",
    "test": "tree-sitter test && npm run test:binding",
    "test:binding": "npm run build && node --test bindings/node/*_test.js",
    "parse": "tree-sitter parse",
    "highlight": "tree-sitter highlight",
    "conformance": "node script/mach-conformance.js"
  },
  "dependencies": {
    "node-addon-api": "^8.0.0",
    "node-gyp-build": "^4.8.0"
  },
  "devDependencies": {
    "tree-sitter": "0.25.1",
    "tree-sitter-cli": "0.26.9"
  },
  "peerDependencies": {
    "tree-sitter": "^0.25.0"
  },
  "peerDependenciesMeta": {
    "tree-sitter": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "files": [
    "grammar.js",
    "intrinsics.js",
    "binding.gyp",
    "prebuilds/**",
    "bindings/node/*",
    "queries/*",
    "src/**",
    "*.wasm"
  ],
  "allowScripts": {
    "tree-sitter@0.25.1": true,
    "tree-sitter-cli@0.26.9": true
  }
}
